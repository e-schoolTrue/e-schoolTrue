{
  "name": "e-school",
  "private": true,
  "version": "1.2.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder --win --linux --publish always",
    "preview": "vite preview",
    "dev:debug": "electron . --remote-debugging-port=9222",
    "test": "vitest --environment jsdom",
    "test:unit": "vitest --environment jsdom",
    "test:coverage": "vitest run --coverage --environment jsdom",
    "rebuild:db-driver": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-native-deps.cjs",
    "prebuild": "npm run rebuild:db-driver",
    "license:cli": "tsx electron/tools/license-cli.ts",
    "db:backup": "tsx --tsconfig tsconfig.node.json electron/tools/db-backup.ts",
    "repair:db": "tsx --tsconfig tsconfig.node.json electron/tools/repair-temporary-tables.ts",
    "migration:create": "typeorm migration:create electron/migrations/",
    "migration:generate": "tsx --tsconfig tsconfig.node.json ./node_modules/typeorm/cli.js migration:generate -d electron/tools/typeorm-datasource.ts electron/migrations/",
    "migration:run": "tsx --tsconfig tsconfig.node.json ./node_modules/typeorm/cli.js migration:run -d electron/tools/typeorm-datasource.ts",
    "migration:show": "tsx --tsconfig tsconfig.node.json ./node_modules/typeorm/cli.js migration:show -d electron/tools/typeorm-datasource.ts",
    "migration:revert": "tsx --tsconfig tsconfig.node.json ./node_modules/typeorm/cli.js migration:revert -d electron/tools/typeorm-datasource.ts",
    "migration:dryrun": "tsx --tsconfig tsconfig.node.json electron/tools/migration-dryrun.ts",
    "db:schema:log": "tsx --tsconfig tsconfig.node.json electron/tools/schema-dump.ts",
    "test:migration:upgrade": "vitest run electron/backend/__tests__/migration-upgrade.spec.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.4.0",
    "@supabase/supabase-js": "^2.49.4",
    "@types/bcryptjs": "^2.4.6",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^9.6.0",
    "bufferutil": "^4.0.9",
    "dotenv": "^16.5.0",
    "electron-print-preview": "^2.2.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "handlebars": "^4.7.8",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "node-machine-id": "^1.1.12",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.1.23",
    "@iconify-json/carbon": "^1.1.31",
    "@iconify-json/ep": "^1.1.15",
    "@iconify-json/mdi": "^1.1.64",
    "@iconify-json/ri": "^1.1.20",
    "@iconify-json/vaadin": "^1.1.9",
    "@iconify/vue": "^4.1.1",
    "@pinia/testing": "^0.0.14",
    "@types/archiver": "^8.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/jspdf": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/devtools": "^6.6.4",
    "@vue/test-utils": "^2.4.6",
    "chart.js": "^4.4.7",
    "date-fns": "^4.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "element-plus": "^2.6.2",
    "jsdom": "^24.1.3",
    "pinia": "^2.3.0",
    "print-js": "^1.6.0",
    "qrcode.vue": "^3.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-icons": "^0.18.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.2.10",
    "xlsx": "^0.18.5"
  },
  "main": "dist-electron/main.js"
}
